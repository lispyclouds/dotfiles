background-opacity = 0.95
cursor-style = "block"
cursor-style-blink = false
font-family = "Iosevka Term"
# Fallback for symbols
font-family = "Symbols Nerd Font Mono"
font-size = 11
font-style = Heavy

keybind = ctrl+s=new_split:down
keybind = ctrl+shift+0=reset_font_size
keybind = ctrl+shift+backspace=clear_screen
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+s=new_split:right
keybind = ctrl+shift+w=close_surface

# https://github.com/folke/tokyonight.nvim/blob/main/extras/ghostty/tokyonight_night
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#ff899d
palette = 10=#9fe044
palette = 11=#faba4a
palette = 12=#8db0ff
palette = 13=#c7a9ff
palette = 14=#a4daff
palette = 15=#c0caf5

background = #1a1b26
foreground = #c0caf5
cursor-color = #c0caf5
selection-background = #283457
selection-foreground = #c0caf5
